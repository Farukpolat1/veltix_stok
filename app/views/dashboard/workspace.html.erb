<% content_for :title, "Depo Paneli" %>

<div class="hero-panel">
  <div class="hero-panel__body">
    <%= render "shared/brand_mark" %>
    <span class="flow-badge flow-badge--purchase mb-2"><i class="bi bi-truck"></i> Depo</span>
    <h1 class="h3 mb-1">Hoş geldin, <%= current_user.display_name %></h1>
    <p class="mb-3">Günlük işlerin için hızlı araçlar aşağıda</p>

    <div class="hero-actions d-flex flex-wrap gap-2">
      <% if current_user.depo? %>
        <%= link_to new_manual_purchase_invoices_path, class: "btn btn-light btn-sm" do %><i class="bi bi-file-earmark-arrow-up"></i> Alış Yap<% end %>
        <%= link_to stock_adjustments_path, class: "btn btn-light btn-sm" do %><i class="bi bi-clipboard-check"></i> Stok Sayımı<% end %>
      <% end %>
      <% if current_user.satis? %>
        <%= link_to new_sale_path, class: "btn btn-light btn-sm" do %><i class="bi bi-bag-plus"></i> Satış Yap<% end %>
      <% end %>
      <%= link_to products_path, class: "btn btn-outline-light btn-sm" do %><i class="bi bi-box-seam"></i> Ürünler<% end %>
    </div>
  </div>
  <div class="hero-panel__art d-none d-md-flex">
    <%= image_tag "hero-cambalkon-photo.jpg", class: "hero-panel__photo", alt: "Polat Pencere" %>
  </div>
</div>

<div class="mb-4">
  <%= render "stock_query" %>
</div>

<div class="row g-3 mb-4">
  <% if current_user.depo? %>
    <div class="col-md-6">
      <%= link_to purchase_invoices_path, class: "text-decoration-none" do %>
        <div class="card stat-card stat-card--purchase h-100">
          <div class="card-body">
            <h2 class="h6 text-muted">Bekleyen Alış Faturası</h2>
            <p class="h3 mb-0 text-dark"><%= @pending_purchase_invoices.size %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if current_user.satis? %>
    <div class="col-md-6">
      <%= link_to sales_path, class: "text-decoration-none" do %>
        <div class="card stat-card stat-card--sale h-100">
          <div class="card-body">
            <h2 class="h6 text-muted">Bekleyen Satış</h2>
            <p class="h3 mb-0 text-dark"><%= @pending_sales.size %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= link_to products_path, class: "text-decoration-none" do %>
      <div class="card stat-card stat-card--alert h-100">
        <div class="card-body">
          <h2 class="h6 text-muted">Düşük Stoklu Ürün</h2>
          <p class="h3 mb-0 text-dark"><%= @low_stock_products.size %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if current_user.depo? && @pending_purchase_invoices.present? %>
  <div class="mb-4">
    <h2 class="h5 mb-3"><i class="bi bi-receipt"></i> Bekleyen Alış Faturaları</h2>
    <table class="table table-sm table-striped align-middle">
      <thead>
        <tr>
          <th>Fatura No</th>
          <th>Tedarikçi</th>
          <th>Tarih</th>
          <th class="text-end"></th>
        </tr>
      </thead>
      <tbody>
        <% @pending_purchase_invoices.each do |invoice| %>
          <tr>
            <td><%= invoice.invoice_number %></td>
            <td><%= invoice.supplier.name %></td>
            <td><%= invoice.created_at.strftime("%d.%m.%Y") %></td>
            <td class="text-end"><%= link_to "Devam Et", items_purchase_invoice_path(invoice), class: "btn btn-sm btn-outline-purchase" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if current_user.satis? && @pending_sales.present? %>
  <div class="mb-4">
    <h2 class="h5 mb-3"><i class="bi bi-bag-check"></i> Bekleyen Satışlar</h2>
    <table class="table table-sm table-striped align-middle">
      <thead>
        <tr>
          <th>Satış No</th>
          <th>Müşteri</th>
          <th>Tarih</th>
          <th class="text-end"></th>
        </tr>
      </thead>
      <tbody>
        <% @pending_sales.each do |sale| %>
          <tr>
            <td><%= sale.sale_number %></td>
            <td><%= sale.customer.name %></td>
            <td><%= sale.created_at.strftime("%d.%m.%Y") %></td>
            <td class="text-end"><%= link_to "Devam Et", items_sale_path(sale), class: "btn btn-sm btn-outline-success" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%= render "low_stock_table" %>
