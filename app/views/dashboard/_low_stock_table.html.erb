<div class="card h-100">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 <%= "mb-3" if @low_stock_products.any? %>">
      <button
        class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 fw-semibold text-dark low-stock-toggle"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#lowStockCollapse"
        aria-expanded="<%= @low_stock_products.any? %>"
        aria-controls="lowStockCollapse"
      >
        <i class="bi bi-chevron-down low-stock-toggle__chevron"></i>
        <span class="h5 mb-0"><i class="bi bi-exclamation-triangle text-warning"></i> Düşük Stoklu Ürünler</span>
        <% if @low_stock_products.any? %>
          <span class="badge bg-warning text-dark rounded-pill"><%= @low_stock_products.size %></span>
        <% end %>
      </button>
      <% if @low_stock_products.any? && policy(Product).index? %>
        <%= link_to "Tümünü Gör / Toplu Düzelt", products_path(low_stock: true), class: "btn btn-sm btn-outline-warning" %>
      <% end %>
    </div>

    <div class="collapse <%= "show" if @low_stock_products.any? %>" id="lowStockCollapse">
      <% if @low_stock_products.any? %>
        <div class="table-responsive">
          <table class="table table-sm table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Kod</th>
                <th>Ad</th>
                <th class="text-end">Stok</th>
                <th class="text-end">Min. Stok</th>
                <th class="text-end">İşlemler</th>
              </tr>
            </thead>
            <tbody>
              <% @low_stock_products.each do |product| %>
                <tr class="table-warning">
                  <td><%= product.code %></td>
                  <td>
                    <% if policy(product).update? %>
                      <%= link_to product.name, edit_product_path(product), class: "link-dark" %>
                    <% else %>
                      <%= product.name %>
                    <% end %>
                  </td>
                  <td class="text-end"><%= product.stock_quantity %></td>
                  <td class="text-end"><%= product.min_stock_level %></td>
                  <td class="text-end">
                    <% if policy(StockAdjustment).create? %>
                      <%= link_to "Stok Ekle", new_stock_adjustment_path(product_id: product.id), class: "btn btn-sm btn-outline-danger" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-success mb-0"><i class="bi bi-check-circle"></i> Kritik seviyenin altında ürün yok.</div>
      <% end %>
    </div>
  </div>
</div>
