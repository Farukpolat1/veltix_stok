<% content_for :title, "Demo Talep Edin" %>

<div class="row justify-content-center">
  <div class="col-md-9 col-lg-7">
    <span class="section-eyebrow mb-3 d-inline-flex"><i class="bi bi-calendar-check"></i> Demo Talebi</span>
    <h1 class="h3 mb-2">Size özel bir demo planlayalım</h1>
    <p class="text-muted mb-4">
      Formu doldurun, kısa bir süre içinde sizinle iletişime geçip
      işletmenize özel bir demo ve fiyat teklifi paylaşalım.
    </p>

    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>

    <% if @demo_request.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @demo_request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card">
      <div class="card-body p-4">
        <%= form_with model: @demo_request, url: demo_requests_path, class: "row g-3" do |f| %>
          <div class="col-md-6">
            <%= f.label :name, "Ad Soyad", class: "form-label" %>
            <%= f.text_field :name, required: true, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :company_name, "Firma Adı", class: "form-label" %>
            <%= f.text_field :company_name, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :email, "E-posta", class: "form-label" %>
            <%= f.email_field :email, required: true, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :phone, "Telefon (opsiyonel)", class: "form-label" %>
            <%= f.telephone_field :phone, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :message, "Mesajınız (opsiyonel)", class: "form-label" %>
            <%= f.text_area :message, rows: 3, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.submit "Gönder", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
