<% if requests.empty? %>
  <p class="text-muted mb-0">
    <%= current_user.super_admin? ? "Bekleyen talep yok." : "Henüz bir talebiniz yok." %>
  </p>
<% else %>
  <div class="d-flex flex-column gap-3">
    <% requests.each do |sr| %>
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
            <div>
              <span class="category-badge me-2"><%= SupportRequest::CATEGORY_LABELS[sr.category] %></span>
              <% if current_user.super_admin? %>
                <span class="text-muted small"><%= sr.company.name %> · <%= sr.user.display_name %></span>
              <% end %>
            </div>
            <span class="badge <%= sr.answered? ? "badge-soft-success" : "badge-soft-warning" %>">
              <%= sr.answered? ? "Yanıtlandı" : "Beklemede" %>
            </span>
          </div>

          <h2 class="h6 mb-1"><%= sr.subject.presence || SupportRequest::CATEGORY_LABELS[sr.category] %></h2>
          <p class="mb-2"><%= simple_format(sr.message) %></p>
          <p class="text-muted small mb-0"><%= sr.created_at.strftime("%d.%m.%Y %H:%M") %></p>

          <% if sr.answered? %>
            <div class="mt-3 p-3 bg-light rounded">
              <p class="small fw-semibold mb-1"><i class="bi bi-reply"></i> Cevap (<%= sr.replied_at.strftime("%d.%m.%Y %H:%M") %>):</p>
              <p class="mb-0"><%= simple_format(sr.reply) %></p>
            </div>
          <% elsif policy(sr).reply? %>
            <%= form_with model: sr, url: support_request_path(sr), method: :patch, class: "mt-3 d-flex gap-2" do |f| %>
              <%= f.text_area :reply, rows: 2, required: true, class: "form-control", placeholder: "Cevabınızı yazın..." %>
              <%= f.submit "Yanıtla", class: "btn btn-sm btn-primary text-nowrap align-self-start" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
