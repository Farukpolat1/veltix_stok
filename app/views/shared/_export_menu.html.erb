<div class="dropdown">
  <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-download"></i> İndir
  </button>
  <ul class="dropdown-menu dropdown-menu-end">
    <% if (csv_path = local_assigns[:csv_path]) %>
      <li><%= link_to csv_path, class: "dropdown-item" do %><i class="bi bi-file-earmark-spreadsheet"></i> Excel (CSV)<% end %></li>
    <% end %>
    <% if (pdf_path = local_assigns[:pdf_path]) %>
      <li><%= link_to pdf_path, target: "_blank", class: "dropdown-item" do %><i class="bi bi-file-earmark-pdf"></i> PDF<% end %></li>
    <% end %>
  </ul>
</div>
