<% support_request = SupportRequest.new %>
<div class="modal fade" id="supportRequestModal" tabindex="-1" aria-labelledby="supportRequestModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="supportRequestModalLabel"><i class="bi bi-headset"></i> Talep Oluştur</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <%= form_with model: support_request, url: support_requests_path do |f| %>
        <div class="modal-body">
          <p class="text-muted small">
            Mesajınız, <strong><%= current_company&.name %></strong> firması ve
            <strong><%= current_user.display_name %></strong> bilgileriyle birlikte bize iletilir.
          </p>
          <div class="mb-3">
            <%= f.label :subject, "Konu (opsiyonel)", class: "form-label" %>
            <%= f.text_field :subject, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :message, "Mesajınız", class: "form-label" %>
            <%= f.text_area :message, rows: 4, required: true, class: "form-control" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
          <%= f.submit "Gönder", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
