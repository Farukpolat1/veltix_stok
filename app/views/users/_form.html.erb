<%= form_with model: user, class: "row g-3" do |f| %>
  <% if user.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, "Ad Soyad", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :email_address, "E-posta", class: "form-label" %>
    <%= f.email_field :email_address, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :role, "Sistem Rolü", class: "form-label" %>
    <% if current_user.super_admin? %>
      <%# Super Admin tüm rolleri verebilir %>
      <%= f.select :role, [ ["Firma Yöneticisi (Admin)", "admin"], ["İstasyon/Saha Sorumlusu", "depo"], ["Satış/Müşteri Hizmetleri", "satis"] ], { prompt: "Rol Seçin" }, class: "form-select" %>
    <% else %>
      <%# Firma Yöneticisi sisteme başka bir admin ekleyemez, sadece operasyon personeli ekleyebilir %>
      <%= f.select :role, [ ["İstasyon/Saha Sorumlusu", "depo"], ["Satış/Müşteri Hizmetleri", "satis"] ], { prompt: "Rol Seçin" }, class: "form-select" %>
    <% end %>
  </div>

  <div class="col-md-6">
    <%= f.label :password, "Şifre", class: "form-label" %>
    <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
    <% if user.persisted? %>
      <div class="form-text">Değiştirmek istemiyorsan boş bırak.</div>
    <% end %>
  </div>

  <div class="col-md-6">
    <%= f.label :password_confirmation, "Şifre (Tekrar)", class: "form-label" %>
    <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
  </div>

  <div class="col-12">
    <%= f.submit "Kaydet", class: "btn btn-primary" %>
    <%= link_to "Vazgeç", users_path, class: "btn btn-link" %>
  </div>
<% end %>