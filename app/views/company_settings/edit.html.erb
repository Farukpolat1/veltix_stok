<% content_for :title, "Firma Ayarları" %>

<h1 class="h3 mb-3">Firma Ayarları</h1>
<p class="text-muted">Bu bilgiler PDF çıktılarında (fiş, ekstre, rapor) ve uygulama genelinde marka olarak kullanılır.</p>

<% if @company.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @company.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @company, url: company_settings_path, method: :patch, class: "row g-3" do |f| %>
  <div class="col-12">
    <label class="form-label">Logo</label>
    <div class="mb-2">
      <% if @company.logo.attached? %>
        <%= image_tag @company.logo, style: "max-height: 80px;" %>
      <% else %>
        <span class="text-muted">Henüz logo yüklenmedi.</span>
      <% end %>
    </div>
    <%= f.file_field :logo, accept: "image/png,image/jpeg,image/svg+xml", class: "form-control" %>
  </div>

  <div class="col-md-8">
    <%= f.label :name, "Firma Adı", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= f.label :phone, "Telefon", class: "form-label" %>
    <%= f.text_field :phone, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :slogan, "Slogan (opsiyonel)", class: "form-label" %>
    <%= f.text_field :slogan, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :address, "Adres", class: "form-label" %>
    <%= f.text_area :address, rows: 2, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :tax_number, "VKN", class: "form-label" %>
    <%= f.text_field :tax_number, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :tax_office, "Vergi Dairesi", class: "form-label" %>
    <%= f.text_field :tax_office, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :website, "Web Sitesi (opsiyonel)", class: "form-label" %>
    <%= f.text_field :website, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :email, "E-posta (opsiyonel)", class: "form-label" %>
    <%= f.text_field :email, class: "form-control" %>
  </div>

  <div class="col-12">
    <hr>
    <div class="form-check form-switch">
      <%= f.check_box :strict_stock_check, class: "form-check-input" %>
      <%= f.label :strict_stock_check, "Satışta stok kontrolü zorunlu olsun", class: "form-check-label" %>
    </div>
    <div class="form-text">Kapatırsanız, stokta yeterli miktar olmasa (hatta 0 olsa) bile satış tamamlanabilir — yeni başlayan veya henüz tam sayım yapmamış firmalar için. Açıksa (varsayılan), stok yetersizse satış tamamlanamaz.</div>
  </div>

  <div class="col-12">
    <%= f.submit "Kaydet", class: "btn btn-primary" %>
  </div>
<% end %>
