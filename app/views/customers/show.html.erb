<% content_for :title, @customer.name %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0"><%= @customer.name %></h1>
    <p class="text-muted mb-0">
      <%= @customer.phone %>
      <% if @customer.code.present? %> · Cari Kodu: <%= @customer.code %><% end %>
      <% if @customer.tax_number.present? %> · VKN/TCKN: <%= @customer.tax_number %><% end %>
      <% if @customer.tax_office.present? %> · Vergi Dairesi: <%= @customer.tax_office %><% end %>
      <% if @customer.il.present? %> · İl: <%= @customer.il %><% end %>
    </p>
    <% if @customer.address.present? %>
      <p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> <%= @customer.address %></p>
    <% end %>
  </div>
  <div>
    <%= link_to "PDF Oluştur", statement_customer_path(@customer), target: "_blank", class: "btn btn-outline-primary" %>
    <%= link_to "Düzenle", edit_customer_path(@customer), class: "btn btn-outline-secondary" %>
    <%= link_to "Listeye Dön", customers_path, class: "btn btn-link" %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 text-muted">Toplam Satış</h2>
        <p class="h4 mb-0"><%= number_with_delimiter(@customer.total_sold) %> ₺</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 text-muted">Toplam Tahsilat</h2>
        <p class="h4 mb-0"><%= number_with_delimiter(@customer.total_paid) %> ₺</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card <%= "border-danger" if @customer.balance.positive? %>">
      <div class="card-body">
        <h2 class="h6 text-muted">Kalan Alacak</h2>
        <p class="h4 mb-0 <%= "text-danger" if @customer.balance.positive? %>"><%= number_with_delimiter(@customer.balance) %> ₺</p>
        <% if @customer.opening_balance.nonzero? %>
          <p class="text-muted small mb-0">(Devir bakiyesi dahil: <%= number_with_delimiter(@customer.opening_balance) %> ₺)</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @pending_sales.any? %>
  <div class="alert alert-warning">
    <strong>Dikkat:</strong> Bu müşteri için henüz <strong>onaylanmamış</strong> <%= @pending_sales.size %> satış var
    (stok henüz düşmedi, aşağıdaki toplamlara dahil değil):
    <ul class="mb-0 mt-2">
      <% @pending_sales.each do |sale| %>
        <li>
          <%= link_to "Satış ##{sale.sale_number}", items_sale_path(sale) %>
          (<%= sale.created_at.strftime("%d.%m.%Y") %>) — tamamlamak için tıklayın
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row g-4">
  <div class="col-md-7">
    <h2 class="h5 mb-3">Satışlar</h2>
    <p class="text-muted small">Ürünleri görmek için bir satışa tıklayın.</p>
    <table class="table table-sm table-striped align-middle">
      <thead>
        <tr>
          <th>Satış No</th>
          <th>Sipariş No</th>
          <th>Tarih</th>
          <th class="text-end">Kalem Sayısı</th>
          <th class="text-end">Toplam Tutar</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.sale_number, items_sale_path(sale) %></td>
            <td><%= sale.external_order_number %></td>
            <td><%= sale.sale_date.strftime("%d.%m.%Y") %></td>
            <td class="text-end"><%= sale.sale_lines.size %></td>
            <td class="text-end"><%= number_with_delimiter(sale.sale_lines.sum(&:total_with_vat).round(2)) %> ₺</td>
            <td class="text-end"><%= link_to "Görüntüle", items_sale_path(sale), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="col-md-5">
    <h2 class="h5 mb-3">Tahsilatlar</h2>

    <% if policy(CustomerPayment).create? %>
      
      <!-- 1. YENİ: PDF İLE OTOMATİK OKUMA KUTUSU -->
      <div class="card mb-4 border-primary">
        <div class="card-body">
          <h6 class="text-primary mb-2"><i class="bi bi-file-earmark-pdf"></i> PDF Dekonttan Otomatik Oku</h6>
          <%= form_with url: parse_pdf_customer_customer_payments_path(@customer), multipart: true, data: { turbo: false }, class: "d-flex gap-2" do |f| %>
            <%= f.file_field :file, class: "form-control form-control-sm", accept: "application/pdf,image/*", required: true %>
            <%= f.submit "Oku ve Onayla", class: "btn btn-sm btn-primary text-nowrap" %>
          <% end %>
        </div>
      </div>

      <!-- 2. ESKİ: MANUEL EKLEME KUTUSU (Senin orijinal kodun) -->
      <div class="card mb-3">
        <div class="card-body">
          <h6 class="text-muted mb-3">Veya Manuel Ekle</h6>
          <%= form_with model: @payment, url: customer_customer_payments_path(@customer), class: "row g-2 align-items-end" do |f| %>
            <div class="col-5">
              <%= f.label :amount, "Tutar", class: "form-label small" %>
              <%= f.number_field :amount, step: "any", class: "form-control form-control-sm" %>
            </div>
            <div class="col-4">
              <%= f.label :paid_at, "Tarih", class: "form-label small" %>
              <%= f.date_field :paid_at, value: Date.current, class: "form-control form-control-sm" %>
            </div>
            <div class="col-3">
              <%= f.submit "Ekle", class: "btn btn-sm btn-success w-100" %>
            </div>
            <div class="col-7">
              <%= f.label :payment_method, "Ödeme Yöntemi", class: "form-label small" %>
              <%= f.select :payment_method, CustomerPayment::PAYMENT_METHOD_LABELS.map { |value, label| [ label, value ] }, {}, class: "form-select form-select-sm" %>
            </div>
            <div class="col-5">
              <%= f.label :note, "Not (opsiyonel)", class: "form-label small" %>
              <%= f.text_field :note, class: "form-control form-control-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <table class="table table-sm table-striped align-middle">
      <thead>
        <tr>
          <th>Tarih</th>
          <th class="text-end">Tutar</th>
          <th>Yöntem</th>
          <th>Not</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @payments.each do |payment| %>
          <tr>
            <td><%= payment.paid_at.strftime("%d.%m.%Y") %></td>
            <td class="text-end"><%= number_with_delimiter(payment.amount) %> ₺</td>
            <td><%= CustomerPayment::PAYMENT_METHOD_LABELS[payment.payment_method] %></td>
            <td><%= payment.note %></td>
            <td class="text-end">
              <% if policy(payment).destroy? %>
                <%= button_to "Sil", customer_customer_payment_path(@customer, payment), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Emin misiniz?" } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>