 <% content_for :title, "Şablondan Ekle — #{@sale.sale_number}" %>

<span class="flow-badge flow-badge--sale mb-2"><i class="bi bi-cart-check"></i> Satış</span>
<h1 class="h3 mb-1">Şablondan Ekle: <%= @product_template.name %></h1>
<p class="text-muted">
  Satış: <strong><%= @sale.sale_number %></strong> — ölçüleri girin, gerekiyorsa her satır için ürünü değiştirin (ör. kolun hangi çeşidi), fiyat/KDV girin. Hiçbir şey henüz kaydedilmedi.
</p>

<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<%= form_with url: create_from_template_sale_path(@sale), method: :post, class: "row g-3" do %>
  <%= hidden_field_tag :product_template_id, @product_template.id %>

  <% if @measurement_fields.any? %>
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h2 class="h6 mb-3">Ölçüler</h2>
          <div class="row g-3">
            <% @measurement_fields.each do |key, label| %>
              <div class="col-md-3">
                <%= label_tag "measurements_#{key}", label, class: "form-label" %>
                <%= number_field_tag "measurements[#{key}]", nil, id: "measurements_#{key}", step: "any", min: 0, required: true, class: "form-control" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% hardware_lookup_lines = @product_template.template_lines.select(&:hardware_schema_lookup?) %>
  <% if hardware_lookup_lines.any? %>
    <div class="col-12">
      <div class="alert alert-info mb-0">
        <i class="bi bi-magic"></i>
        <% hardware_lookup_lines.each do |line| %>
          <strong><%= line.label %></strong> — kanat genişliği/yüksekliğine göre doğru donanım kiti (İspanyolet, Makas, menteşeler, kilit karşılıkları vb.) otomatik seçilip eklenecek, elle seçim gerekmiyor.
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 mb-3">Malzeme Satırları</h2>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th>Etiket</th>
                <th style="width:220px">Ürün</th>
                <th style="width:120px">Birim Fiyat</th>
                <th style="width:100px">KDV %</th>
              </tr>
            </thead>
            <tbody>
              <% @product_template.template_lines.reject(&:hardware_schema_lookup?).each do |line| %>
                <tr>
                  <td>
                    <%= line.label %>
                    <div class="text-muted small"><%= line.category.name %> · <%= line.variable_label %></div>
                  </td>
                  <td>
                    <%= select_tag "product_ids[#{line.id}]", options_from_collection_for_select(line.candidate_products, :id, :name, line.default_product_id), include_blank: "Seçiniz", class: "form-select form-select-sm" %>
                  </td>
                  <td>
                    <%= number_field_tag "unit_prices[#{line.id}]", @last_prices[line.id] || 0, step: "any", min: 0, class: "form-control form-control-sm" %>
                    <% if @last_prices[line.id] %>
                      <div class="text-muted small">son satış fiyatı</div>
                    <% end %>
                  </td>
                  <td>
                    <%= select_tag "vat_rates[#{line.id}]", options_for_select([ 0, 1, 10, 20 ], 20), class: "form-select form-select-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <%= submit_tag "Satırları Ekle", class: "btn btn-success btn-lg" %>
    <%= link_to "Vazgeç", items_sale_path(@sale), class: "btn btn-link" %>
  </div>
<% end %>
