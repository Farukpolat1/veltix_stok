<% content_for :title, "Satış: Ürün Ekle" %>

<div class="d-flex justify-content-between align-items-start mb-2">
  <div>
    <span class="flow-badge flow-badge--sale mb-2"><i class="bi bi-cart-check"></i> Satış</span>
    <h1 class="h3 mb-1">Satış: <%= @sale.sale_number %></h1>
  </div>
  <div class="d-flex gap-2">
    <% if @sale.sale_lines.any? %>
      <%= link_to receipt_sale_path(@sale), target: "_blank", class: "btn btn-success btn-lg" do %><i class="bi bi-file-earmark-pdf"></i> PDF İrsaliye İndir<% end %>
    <% end %>
    <% if policy(@sale).edit? %>
      <%= link_to edit_sale_path(@sale), class: "btn btn-outline-secondary btn-sm" do %><i class="bi bi-pencil"></i> Düzenle<% end %>
    <% end %>
    <%= link_to sales_path, class: "btn btn-outline-secondary btn-sm" do %><i class="bi bi-arrow-left"></i> Satışlara Dön<% end %>
  </div>
</div>
<p class="text-muted mb-3">
  Müşteri: <% if policy(@sale.customer).show? %><%= link_to @sale.customer.name, customer_path(@sale.customer) %><% else %><%= @sale.customer.name %><% end %> ·
  Tarih: <%= @sale.sale_date %>
  <% if @sale.external_order_number.present? %>
    · Sipariş No: <%= @sale.external_order_number %>
  <% end %>
</p>

<% if @sale.source_pdfs.attached? %>
  <% if @sale.source_pdfs.attached? %>
  <div class="alert alert-info d-flex align-items-center py-2 mb-3">
    <i class="bi bi-paperclip fs-5 me-2"></i>
    <strong class="me-3">Yüklenen Belgeler:</strong>
    
    <% @sale.source_pdfs.each do |pdf| %>
      <%= link_to rails_blob_path(pdf, disposition: "inline"), target: "_blank", class: "btn btn-sm btn-primary me-2" do %>
        <i class="bi bi-eye"></i> Görüntüle (<%= pdf.filename.extension %>)
      <% end %>
      
      <%= link_to rails_blob_path(pdf, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary me-3" do %>
        <i class="bi bi-download"></i> İndir
      <% end %>
    <% end %>
  </div>
<% end %>
    <i class="bi bi-paperclip"></i> Yüklenen kaynak belgeler:
    <% @sale.source_pdfs.each do |pdf| %>
      <%= link_to pdf.filename.to_s, rails_blob_path(pdf, disposition: "inline"), target: "_blank", class: "link-secondary me-2" %>
    <% end %>
  </p>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<% if @sale.pending? %>
  <div class="<%= "collapse" unless @sale.sale_lines.none? %> show" id="manual-add">
    <%= render "shared/product_item_form",
          url: sale_sale_lines_path(@sale),
          products: @products,
          categories: @categories,
          param_key: "sale_line" %>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h6 mb-2"><i class="bi bi-file-earmark-pdf"></i> PDF'ten Ürün Ekle (opsiyonel)</h2>
      <p class="text-muted small mb-2">Müşteriden gelen sipariş/ürün listesi PDF'ini yükleyin, satırları önizleyip ekleyin.</p>
      <%= form_with url: import_lines_pdf_sale_path(@sale), method: :post, scope: :sale, multipart: true, data: { turbo: false }, class: "d-flex gap-2" do %>
        <input type="file" name="sale[pdf_file]" accept=".pdf" class="form-control">
        <button type="submit" class="btn btn-outline-primary text-nowrap">PDF'ten Oku</button>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <h2 class="h5 mb-3">Satış İçeriği</h2>
    <table class="table table-striped align-middle mb-3">
      <thead>
        <tr>
          <th>Ürün</th>
          <th class="text-end">Miktar</th>
          <th class="text-end">Birim Fiyat</th>
          <th class="text-end">KDV %</th>
          <th class="text-end">KDV Tutarı</th>
          <th class="text-end">Toplam</th>
          <% if @sale.pending? %><th></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @sale.sale_lines.each do |line| %>
          <tr class="<%= "table-danger" if line.insufficient_stock? %>">
            <td>
              <%= line.product.name %>
              <% if line.insufficient_stock? %>
                <span class="badge bg-danger">Stok yetersiz: <%= line.product.stock_quantity %> <%= line.product.unit_label %> var</span>
                <%= link_to "Stok Ekle", new_stock_adjustment_path(product_id: line.product_id), class: "btn btn-sm btn-outline-danger ms-1" %>
              <% end %>
            </td>
            <td class="text-end"><%= line.quantity %></td>
            <td class="text-end"><%= line.unit_price %></td>
            <td class="text-end">%<%= line.vat_rate.to_i %></td>
            <td class="text-end"><%= number_with_delimiter(line.vat_amount.round(2)) %> ₺</td>
            <td class="text-end fw-bold"><%= number_with_delimiter(line.total_with_vat.round(2)) %> ₺</td>
            <% if @sale.pending? %>
              <td class="text-end">
                <%= button_to "Sil", sale_sale_line_path(@sale, line), method: :delete, class: "btn btn-sm btn-outline-danger" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <% if @sale.sale_lines.any? %>
        <tfoot>
          <tr class="fw-bold">
            <td colspan="5" class="text-end">Genel Toplam (KDV Dahil)</td>
            <td class="text-end"><%= number_with_delimiter(@sale.sale_lines.sum(&:total_with_vat).round(2)) %> ₺</td>
            <% if @sale.pending? %><td></td><% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>

    <% if @sale.pending? %>
      <%= button_to "Satışı Tamamla ve Stoktan Düş", approve_sale_path(@sale), method: :patch, class: "btn btn-success btn-lg", disabled: !@sale.approvable?, form: { data: { turbo_confirm: "Satış tamamlanacak ve stok azaltılacak. Emin misiniz?" } } %>
      <% if @sale.sale_lines.none? %>
        <p class="text-danger mt-2 mb-0">Tamamlamak için en az bir ürün eklemelisiniz.</p>
      <% elsif @sale.insufficient_stock_lines.any? %>
        <p class="text-danger mt-2 mb-0">
          Şu ürünlerin stoğu yetersiz, tamamlamadan önce stok girin:
          <% @sale.insufficient_stock_lines.each do |l| %>
            <%= link_to l.product.name, new_stock_adjustment_path(product_id: l.product_id), class: "link-danger" %><%= ", " unless l == @sale.insufficient_stock_lines.last %>
          <% end %>
        </p>
      <% end %>
    <% else %>
      <span class="badge badge-soft-success">Satış tamamlandı</span>
    <% end %>
  </div>
</div>
