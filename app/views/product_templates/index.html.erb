<% content_for :title, "Şablonlar" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-1">Şablonlar</h1>
    <p class="text-muted small mb-0">Bir pencere/kapı tipinin hangi malzemelerden ne kadar kullandığını tanımlayın — satış/alışta "Şablondan Ekle" ile otomatik listelenir.</p>
  </div>
  <% if policy(ProductTemplate).create? %>
    <%= link_to new_product_template_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg"></i> Yeni Şablon<% end %>
  <% end %>
</div>

<% if @product_templates.any? %>
  <div class="row row-cols-1 row-cols-md-2 g-3">
    <% @product_templates.each do |template| %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h2 class="h6 mb-1"><%= template.name %></h2>
              <% if template.active? %>
                <span class="badge badge-soft-success">Aktif</span>
              <% else %>
                <span class="badge bg-secondary">Pasif</span>
              <% end %>
            </div>
            <p class="text-muted small mb-2"><%= template.code %></p>
            <p class="small mb-3"><%= template.description %></p>
            <p class="small text-muted mb-3"><i class="bi bi-list-ul"></i> <%= pluralize(template.template_lines.size, "satır") %></p>
            <div class="d-flex gap-2 flex-wrap">
              <%= link_to lines_product_template_path(template), class: "btn btn-sm btn-outline-primary" do %><i class="bi bi-diagram-3"></i> Satırları Yönet<% end %>
              <% if policy(template).update? %>
                <%= link_to edit_product_template_path(template), class: "btn btn-sm btn-outline-secondary" do %><i class="bi bi-pencil"></i> Düzenle<% end %>
              <% end %>
              <% if policy(template).destroy? %>
                <%= button_to product_template_path(template), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Şablon silinsin mi?" } } do %><i class="bi bi-trash"></i><% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <div class="card-body text-center text-muted py-5">
      <i class="bi bi-diagram-3 fs-1 d-block mb-2"></i>
      Henüz şablon yok. "Yeni Şablon" ile ilk pencere/kapı tipinizi tanımlayın.
    </div>
  </div>
<% end %>
