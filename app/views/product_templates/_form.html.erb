<%= form_with model: product_template, class: "row g-3" do |f| %>
  <% if product_template.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% product_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, "Ad (örn. 70lik Sürme 120x150)", class: "form-label" %>
    <%= f.text_field :name, class: "form-control form-control-lg" %>
  </div>

  <div class="col-md-6">
    <%= f.label :code, "Kod (opsiyonel)", class: "form-label" %>
    <%= f.text_field :code, class: "form-control form-control-lg" %>
  </div>

  <div class="col-12">
    <%= f.label :description, "Açıklama (opsiyonel)", class: "form-label" %>
    <%= f.text_area :description, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12">
    <div class="form-check form-switch">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Aktif — satış/alışta seçilebilir", class: "form-check-label" %>
    </div>
  </div>

  <div class="col-12">
    <%= f.submit "Kaydet", class: "btn btn-primary" %>
    <%= link_to "Vazgeç", product_templates_path, class: "btn btn-link" %>
  </div>
<% end %>
