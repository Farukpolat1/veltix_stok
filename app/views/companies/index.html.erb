<% content_for :title, "Firmalar" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <span class="flow-badge flow-badge--purchase mb-2"><i class="bi bi-buildings"></i> Platform</span>
    <h1 class="h3 mb-0">Firmalar</h1>
  </div>
  <%= link_to new_company_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg"></i> Yeni Firma Ekle<% end %>
</div>
<p class="text-muted">Bu sistemi kullanan tüm firmalar (müşteriler) — her biri kendi verisini görür, birbirininkini göremez.</p>

<table class="table table-striped align-middle">
  <thead>
    <tr>
      <th>Firma Adı</th>
      <th>Telefon</th>
      <th>VKN</th>
      <th class="text-end">Kullanıcı Sayısı</th>
      <th>Oluşturulma</th>
      <th class="text-end">İşlemler</th>
    </tr>
  </thead>
  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.name %></td>
        <td><%= company.phone %></td>
        <td><%= company.tax_number.presence || "—" %></td>
        <td class="text-end"><%= company.users.count %></td>
        <td><%= company.created_at.strftime("%d.%m.%Y") %></td>
        <td class="text-end">
          <% if current_company == company && !impersonating? %>
            <span class="badge bg-secondary me-2">Şu anki firmanız</span>
          <% end %>
          <%= render layout: "shared/actions_menu" do %>
            <% if policy(company).impersonate? && !(current_company == company && !impersonating?) %>
              <li><%= button_to impersonate_company_path(company), method: :post, class: "dropdown-item" do %><i class="bi bi-arrow-repeat"></i> Bu Firmaya Geç<% end %></li>
            <% end %>
            <% if policy(company).update? %>
              <li><%= link_to edit_company_path(company), class: "dropdown-item" do %><i class="bi bi-pencil"></i> Düzenle<% end %></li>
            <% end %>
            <% if policy(company).destroy? %>
              <li><%= button_to company_path(company), method: :delete, class: "dropdown-item text-danger", form: { data: { turbo_confirm: "\"#{company.name}\" firmasını ve TÜM verilerini (kullanıcılar, müşteriler, ürünler, satışlar, faturalar dahil) kalıcı olarak silmek istediğinize emin misiniz? Bu işlem GERİ ALINAMAZ." } } do %><i class="bi bi-trash"></i> Sil<% end %></li>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
