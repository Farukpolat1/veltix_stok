<% content_for :title, "PDF Önizleme — Alış" %>

<span class="flow-badge flow-badge--purchase mb-2"><i class="bi bi-truck"></i> Alış</span>
<h1 class="h3 mb-1">PDF'ten Okunan Veriyi Gözden Geçirin</h1>
<p class="text-muted">
  Aşağıdaki bilgiler PDF'ten yapay zeka ile okundu, henüz hiçbir şey kaydedilmedi.
  Kontrol edin, gerekirse düzeltin, sonra onaylayın.
</p>

<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="position-sticky" style="top: 1rem;">
      <% if @pdf_blob %>
        <iframe src="<%= rails_blob_path(@pdf_blob, disposition: "inline") %>" style="width: 100%; height: 82vh; border: 1px solid var(--bs-border-color); border-radius: 0.5rem;"></iframe>
      <% end %>
    </div>
  </div>

  <div class="col-lg-6">
    <%= form_with url: confirm_pdf_purchase_invoices_path, method: :post, scope: :purchase_invoice, data: { controller: "edit-tracker" }, class: "row g-3" do %>
      <%= hidden_field_tag "purchase_invoice[pdf_blob_signed_id]", @pdf_blob&.signed_id %>

      <div class="col-12">
        <% if @matched_supplier %>
          <div class="alert alert-info d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-check-circle"></i>
            <div><strong><%= @matched_supplier.name %></strong> ile eşleşti<%= " (kod: #{@matched_supplier.code})" if @matched_supplier.code.present? %>. Onaylarsanız bu carinin hesabına işlenecek.</div>
          </div>
        <% else %>
          <div class="alert alert-warning d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-person-plus"></i>
            <div>Sistemde eşleşen tedarikçi bulunamadı — <strong>yeni tedarikçi</strong> olarak oluşturulacak. Bilgileri kontrol edip tamamlayın.</div>
          </div>
        <% end %>
      </div>

      <div class="col-md-6" data-edit-tracker-target="wrapper">
        <label class="form-label">Tedarikçi Adı</label>
        <%= text_field_tag "purchase_invoice[supplier][name]", @data.dig(:supplier, :name), id: nil, required: true, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>
      <div class="col-md-6" data-edit-tracker-target="wrapper">
        <label class="form-label">VKN/TCKN (opsiyonel)</label>
        <%= text_field_tag "purchase_invoice[supplier][tax_number]", @data.dig(:supplier, :tax_number), id: nil, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>

      <div class="col-md-4" data-edit-tracker-target="wrapper">
        <label class="form-label">Vergi Dairesi (opsiyonel)</label>
        <%= text_field_tag "purchase_invoice[supplier][tax_office]", @data.dig(:supplier, :tax_office), id: nil, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>
      <div class="col-md-4" data-edit-tracker-target="wrapper">
        <label class="form-label">Telefon (opsiyonel)</label>
        <%= text_field_tag "purchase_invoice[supplier][phone]", @data.dig(:supplier, :phone), id: nil, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>
      <div class="col-md-4" data-edit-tracker-target="wrapper">
        <label class="form-label">Adres (opsiyonel)</label>
        <%= text_field_tag "purchase_invoice[supplier][address]", @data.dig(:supplier, :address), id: nil, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>

      <div class="col-md-6" data-edit-tracker-target="wrapper">
        <label class="form-label">Fatura No</label>
        <%= text_field_tag "purchase_invoice[invoice_number]", @data[:invoice_number], id: nil, required: true, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>
      <div class="col-md-6" data-edit-tracker-target="wrapper">
        <label class="form-label">Fatura Tarihi</label>
        <%= date_field_tag "purchase_invoice[invoice_date]", @data[:invoice_date], id: nil, required: true, class: "form-control", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %>
        <span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değiştirildi</span>
      </div>

      <div class="col-12">
        <h2 class="h5 mt-3 mb-2">Ürün Satırları</h2>
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th style="width:120px">Ürün Kodu</th>
              <th>Ürün Adı</th>
              <th style="width:220px">Ürün Eşleştirme</th>
              <th style="width:110px">Miktar</th>
              <th style="width:140px">Birim Fiyat</th>
              <th style="width:100px">KDV %</th>
            </tr>
          </thead>
          <tbody>
            <% Array(@data[:lines]).each_with_index do |line, i| %>
              <tr>
                <td data-edit-tracker-target="wrapper"><%= text_field_tag "purchase_invoice[lines][][code]", line[:code], id: nil, class: "form-control form-control-sm", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %><span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değişti</span></td>
                <td data-edit-tracker-target="wrapper"><%= text_field_tag "purchase_invoice[lines][][name]", line[:name], id: nil, class: "form-control form-control-sm", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %><span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değişti</span></td>
                <td><%= render "shared/product_match_cell", field_name: "purchase_invoice[lines][][matched_product_id]", match: @line_matches&.[](i) || { exact: nil, suggestions: [] } %></td>
                <td data-edit-tracker-target="wrapper"><%= number_field_tag "purchase_invoice[lines][][quantity]", line[:quantity], id: nil, step: "any", class: "form-control form-control-sm", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %><span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değişti</span></td>
                <td data-edit-tracker-target="wrapper"><%= number_field_tag "purchase_invoice[lines][][unit_price]", line[:unit_price], id: nil, step: "any", class: "form-control form-control-sm", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %><span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değişti</span></td>
                <td data-edit-tracker-target="wrapper"><%= number_field_tag "purchase_invoice[lines][][vat_rate]", line[:vat_rate] || 20, id: nil, step: "any", class: "form-control form-control-sm", data: { edit_tracker_target: "field", action: "input->edit-tracker#check" } %><span class="badge bg-warning-subtle text-warning-emphasis d-none" data-edit-tracker-target="badge">değişti</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="col-12">
        <%= submit_tag "Onayla ve Kaydet", class: "btn btn-success btn-lg" %>
        <%= link_to "Vazgeç", purchase_invoices_path, class: "btn btn-link" %>
      </div>
    <% end %>
  </div>
</div>
