# aistudio.google.com üzerinden alınan Gemini API anahtarı.
# Alış/satış PDF'inden otomatik ürün okuma özelliği için kullanılır.
GEMINI_API_KEY=

# Opsiyonel, varsayılan: gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest

# console.anthropic.com üzerinden alınan Claude API anahtarı (opsiyonel —
# şu an PDF okuma Gemini kullanıyor, bu sadece ileride tekrar Claude'a
# geçilirse gerekir).
ANTHROPIC_API_KEY=

# resend.com üzerinden alınan API anahtarı — şifre sıfırlama ve hesap onay
# e-postalarının gerçekten gönderilebilmesi için gerekli. Boş bırakılırsa
# (local'de) e-postalar hiçbir yere gönderilmez, sadece test ortamında
# ActionMailer::Base.deliveries içine düşer. Production'da ZORUNLUDUR.
RESEND_API_KEY=

# E-postaların "kimden" göründüğü adres — Resend'de doğrulanmış bir alan
# adına ait olmalı (resend.com/domains), aksi halde gönderim reddedilir.
# Örnek: bildirim@veltix.com
MAILER_FROM_ADDRESS=no-reply@example.com

# Production'da uygulamanın gerçek alan adı — e-posta içindeki linklerin
# (şifre sıfırlama, hesap onaylama) doğru adrese işaret etmesi için gerekli.
# Örnek: app.veltix.com
APP_HOST=example.com

# sentry.io üzerinden ücretsiz bir proje açıp alınan DSN — production'da
# yakalanmayan hatalar (500) buraya otomatik bildirilir. Boş bırakılırsa
# (local/test) Sentry hiçbir şey yapmaz, uygulama etkilenmez.
SENTRY_DSN=

# --- Dosya depolama (Active Storage → Cloudflare R2) ------------------------
# Production'da yüklenen PDF/görsellerin container diskinde değil, kalıcı bir
# bulut depoda (Cloudflare R2 — dashboard.cloudflare.com → R2) tutulması için.
# Boş bırakılırsa production ayakta kalmaya devam eder ama dosyalar
# container'ın kendi diskinde saklanır (her deploy/restart'ta kaybolabilir —
# geçici test dışında önerilmez).
# R2_ENDPOINT: R2 bucket'ınızın "S3 API" adresi
# (https://<account_id>.r2.cloudflarestorage.com gibi).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=